rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks collection
    match /tasks/{taskId} {
      // Users can read, update, and delete only their own tasks
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Users can create tasks if they set themselves as the owner
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // UserDailyActionConfig collection
    match /userDailyActionConfigs/{actionId} {
      // Users can read, update, and delete only their own action configs
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Users can create action configs if they set themselves as the owner
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 